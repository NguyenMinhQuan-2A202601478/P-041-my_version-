# Copy this file to .env and fill in real values. Never commit .env.
# All values below are placeholders — replace before running.

# ===== Database =====
# For local dev without Docker (SQLite, single file):
# DATABASE_URL=sqlite:///./dev.db
# For Docker Compose (PostgreSQL) — host "db" is the compose service name:
DATABASE_URL=postgresql://cv_assistant:changeme@db:5432/cv_assistant
POSTGRES_USER=cv_assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cv_assistant

# ===== Qdrant (Vector DB) =====
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ===== LLM Provider =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your_api_key_here

# ===== Auth (JWT) =====
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
